rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'joemariegpangan18@gmail.com' ||
        request.auth.token.email == 'hr.oligarchmedia@gmail.com' ||
        request.auth.token.email == 'oligarchmediaph@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@oligarchmedia.*')) ||
        request.auth.token.firebase.sign_in_provider == 'anonymous' ||
        request.auth != null
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Company Settings (Shift parameters, work hours, grace periods)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Employees Roster (Profiles, designations, schedules)
    match /employees/{employeeId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Attendance Records (Time In, Time Out, Breaks, Overtime)
    // Accessible by employees for daily punching; deletions restricted to Admin
    match /attendance/{attendanceId} {
      allow read: if true;
      allow create: if isValidId(attendanceId);
      allow update: if isValidId(attendanceId);
      allow delete: if isAdmin();
    }

    // Payroll Records (Confidential salary computation, 13th month, net vouchers)
    match /payroll/{payrollId} {
      allow read, write: if isSignedIn();
    }

    // Payroll Cutoff Periods
    match /payroll_periods/{periodId} {
      allow read, write: if isSignedIn();
    }

    // Leave & Absence Requests
    // Submitted by employees; approved/managed by Admin
    match /leave_requests/{requestId} {
      allow read, create: if isValidId(requestId);
      allow update, delete: if isSignedIn();
    }

    // Attendance Copy Requests
    match /attendance_copy_requests/{requestId} {
      allow read, create: if isValidId(requestId);
      allow update, delete: if isSignedIn();
    }

    // Cash Advances & Financial Loans
    match /cash_advances/{id} {
      allow read, write: if isSignedIn();
    }

    // Boss Debts & Personal Advances
    match /boss_debts/{id} {
      allow read, write: if isSignedIn();
    }

    // Declared Non-Working Days / Holidays
    match /no_work_days/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Devotion & Prayer Schedules
    // Publicly readable so daily flyer and portal prayer cards load
    match /devotion_schedules/{scheduleId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Devotion Flyer Settings & Rotation State
    match /devotion_settings/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Broadcast Announcements / Bulletin
    match /announcements/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // In-App Notifications
    match /notifications/{id} {
      allow read, create, update, delete: if true;
    }

    // Audit Logs (Append-only by system, read restricted to Admin)
    match /audit_logs/{id} {
      allow create: if isValidId(id);
      allow read: if isSignedIn();
      allow update, delete: if false;
    }

    // Email Dispatch Transaction Logs
    match /email_logs/{id} {
      allow create: if isValidId(id);
      allow read: if isSignedIn();
      allow update, delete: if false;
    }

    // Deleted Records (Global tombstone registry to prevent resurrection)
    match /deleted_records/{id} {
      allow read, write: if isSignedIn();
    }
  }
}
