# ==========================================
# Vercel & Production Environment Variables
# ==========================================

# 1. GEMINI AI (Required for AI Attendance Screenshot Scanner & Spreadsheet Parser)
# In Vercel, add both or either of these in Settings -> Environment Variables:
GEMINI_API_KEY="AIzaSy..."
VITE_GEMINI_API_KEY="AIzaSy..."

# 2. APP URL
APP_URL="https://your-project.vercel.app"

# 3. FIREBASE CONFIGURATION (Already pre-configured in firebase-applet-config.json)
# If you want to connect to a different custom Firebase project in Vercel:
# VITE_FIREBASE_API_KEY="AIzaSy..."
# VITE_FIREBASE_PROJECT_ID="spherical-program-f3n78"
# VITE_FIREBASE_AUTH_DOMAIN="spherical-program-f3n78.firebaseapp.com"
# VITE_FIREBASE_DATABASE_ID="ai-studio-2a6bf0ee-3447-4fcc-b543-9a65f6e88879"

# 4. EMAIL DISPATCH (Optional: if not using Google OAuth 1-Click Send in Admin Console)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="16-character-google-app-password"
# SMTP_SENDER_NAME="Oligarch Media Graphic Design Studio"
